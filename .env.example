# ============ Ask Your Books — environment config ============
# Copy to .env and adjust. Everything here overrides config/settings.yaml.

# --- LLM provider: one of  openai | groq | ollama | mock  ---
# mock = deterministic local provider (no network, used by tests/eval by default)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# --- "today" for all period/ageing calculations (FY = 1 Apr – 31 Mar) ---
TODAY=2026-10-01

# --- who is logged in (used by the CLI; the API reads X-User-Id header) ---
USER_ID=U301

# --- database ---
DB_PATH=books.db

# --- guardrails ---
SQL_TIMEOUT_SECONDS=5
SQL_ROW_LIMIT=500
AGENT_MAX_ITERATIONS=6

# --- server ---
API_HOST=0.0.0.0
API_PORT=8000