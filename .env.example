# ============ Ask Your Books — environment config ============
# Copy to .env and adjust. Everything here overrides config/settings.yaml.

# --- LLM: only these three matter for a real provider ---
# provider: openai | groq | ollama | gemini | claude | openrouter | mock
# mock = offline deterministic provider (no network, no key; tests/eval default)
# model + base_url + cost are auto-filled per provider (see src/llm/providers.py)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

# (advanced) override the auto-derived base_url, e.g. a self-hosted gateway:
# LLM_BASE_URL=

# --- "today" for all period/ageing calculations (FY = 1 Apr – 31 Mar) ---
TODAY=2026-10-01

# --- who is logged in (used by the CLI; the API reads X-User-Id header) ---
USER_ID=U301

# --- database ---
DB_PATH=books.db

# --- guardrails ---
SQL_TIMEOUT_SECONDS=5
SQL_ROW_LIMIT=500
AGENT_MAX_ITERATIONS=6

# --- server ---
API_HOST=0.0.0.0
API_PORT=8000